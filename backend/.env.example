# Supabase
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=

# OpenCode (primary answer provider)
OPENCODE_API_KEY=your_opencode_api_key
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL=deepseek-v4-flash-free
CHAT_ANSWER_MAX_TOKENS=1000
DOCUMENT_SUMMARY_MAX_TOKENS=1500

# Gemini (2nd answer-generation fallback; leave key blank to disable)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash

# OpenRouter (3rd answer-generation fallback)
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_LLM_PRIMARY=deepseek/deepseek-v4-flash:free

# Retrieval
CHROMA_PERSIST_PATH=./chroma_data
CHROMA_COLLECTION_NAME=chat_with_pdf
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVAL_RRF_K=60
RETRIEVAL_RERANK_K=60
RETRIEVAL_NEIGHBOR_WINDOW=1
RETRIEVAL_SEMANTIC_CACHE_ENABLED=true
RETRIEVAL_SEMANTIC_CACHE_THRESHOLD=0.94
RETRIEVAL_SEMANTIC_CACHE_MAX_ENTRIES=256
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_TIMEOUT_SECONDS=5
QUERY_EXPANSION_MAX_TOKENS=180
QUERY_EXPANSION_FAILURE_THRESHOLD=3
QUERY_EXPANSION_COOLDOWN_SECONDS=300

# LangSmith
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=chat-with-pdf

# Rate limiting (per user, per minute)
CHAT_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# App
APP_ENV=development
RUN_INGESTION_ON_MODAL=false
MODAL_APP_NAME=chat-with-pdf
MODAL_INGESTION_FUNCTION_NAME=run_ingestion
ALLOWED_ORIGINS=http://localhost:5173
MAX_FILE_SIZE_MB=50

# Debug auth script only
DEBUG_AUTH_EMAIL=your_test_user_email
DEBUG_AUTH_PASSWORD=your_test_user_password
DEBUG_BACKEND_URL=http://127.0.0.1:8000
